# Copy this file to .env and fill in your real values
# Never commit .env to git — it's already in .gitignore

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — use test keys locally, live keys on Railway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...        # from Stripe Dashboard → Products

# Redis — Upstash free tier gives you a URL like:
# rediss://default:xxxxx@us1-xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Your deployed URL (no trailing slash)
# Locally: http://localhost:8000
# Production: https://yourapp.railway.app or https://profilerewrite.com
BASE_URL=http://localhost:8000
